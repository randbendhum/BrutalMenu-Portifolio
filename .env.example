APP_NAME="Humberto // Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# Custom domain for Oracle Cloud ARM production (used by Caddy in docker-compose.prod.yml)
DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8 Database (Docker service name: mysql)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
FORWARD_DB_PORT=3306

SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# PORTFOLIO PERSONALIZATION (Or edit config/portfolio.php directly for full control)
# ==============================================================================
PORTFOLIO_NAME="Humberto"
PORTFOLIO_HANDLE="HUMBERTO.DEV"
PORTFOLIO_ROLE="Full-Stack & Front-End Developer"
PORTFOLIO_TAGLINE="I build fast, bold, resilient web applications from pixel-sharp UIs to scalable backends."
PORTFOLIO_LOCATION="Brazil // Remote Worldwide"
PORTFOLIO_AVAILABLE=true
PORTFOLIO_AVAILABILITY_TEXT="AVAILABLE FOR FREELANCE & FULL-TIME"
PORTFOLIO_EMAIL="contact@humbertorandon.com"
PORTFOLIO_GITHUB="https://github.com/randbendhum"
PORTFOLIO_LINKEDIN="https://www.linkedin.com/in/humberto-randon-17a065428"
PORTFOLIO_RESUME_URL="#"

# ==============================================================================
# ADMIN PANEL CREDENTIALS (Access at /admin to add/edit projects & read messages)
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
